# Use SQLite locally. Set this to your Supabase PostgreSQL connection URL when deploying.
DATABASE_URL=sqlite:///./costsaver.db

# Generate a unique long random value before deployment. Never commit a real secret.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=your-email@example.com
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://areeb7867.github.io
